        int width = LOWORD(lParam);
        int height = HIWORD(lParam);

        int statusHeight = 25;   // 兜底高度

        if (hStatus != NULL)
        {
            SendMessageW(hStatus, WM_SIZE, 0, 0);

            RECT rcStatus = {};
            GetWindowRect(hStatus, &rcStatus);
            int h = rcStatus.bottom - rcStatus.top;
            if (h > 0)
                statusHeight = h;
        }

        if (hEdit != NULL)
        {
            MoveWindow(
                hEdit,
                0,
                55,
                width,
                max(0, height - 55 - statusHeight),
                TRUE
            );
        }

        return 0;
    }


    // ========================================================
    // 通知消息（编辑框选择变化 → 刷新状态栏）
    // ========================================================
    case WM_NOTIFY:
    {
        NMHDR* pnm = (NMHDR*)lParam;

        if (pnm != NULL &&
            pnm->hwndFrom == hEdit &&
            pnm->code == EN_SELCHANGE)
        {
            UpdateStatusBar();
        }

        return 0;
    }


    // ========================================================
    // 命令消息
    // ========================================================
    case WM_COMMAND:
    {
        // ==============================
        // 编辑框内容发生变化
        // ==============================
        if (HIWORD(wParam) == EN_CHANGE &&
            (HWND)lParam == hEdit)
        {
            g_isModified = true;
            UpdateStatusBar();
        }


        switch (LOWORD(wParam))
        {
            // ====================================================
            // 打开
            // ====================================================
        case ID_BUTTON_OPEN:

            OpenNote(hwnd);

            return 0;


            // ====================================================
            // 保存
            // ====================================================
        case ID_BUTTON_SAVE:

            SaveNote(hwnd);

            return 0;


            // ====================================================
            // 撤销
            // ====================================================
        case ID_BUTTON_UNDO:

            SendMessageW(hEdit, EM_UNDO, 0, 0);
            UpdateStatusBar();

            return 0;


            // ====================================================
            // 重做
            // ====================================================
        case ID_BUTTON_REDO:

            SendMessageW(hEdit, EM_REDO, 0, 0);
            UpdateStatusBar();

            return 0;


            // ====================================================
            // 剪切
            // ====================================================
        case ID_BUTTON_CUT:

            SendMessageW(hEdit, WM_CUT, 0, 0);

            return 0;


            // ====================================================
            // 复制
            // ====================================================
        case ID_BUTTON_COPY:

            SendMessageW(hEdit, WM_COPY, 0, 0);

            return 0;


            // ====================================================
            // 粘贴
            // ====================================================
        case ID_BUTTON_PASTE:

            SendMessageW(hEdit, WM_PASTE, 0, 0);

            return 0;


            // ====================================================
            // 查找
            // ====================================================
        case ID_BUTTON_FIND:

            ShowFindWindow(hwnd);

            return 0;


            // ====================================================
            // 字体
            // ====================================================
        case ID_COMBO_FONT:

            if (HIWORD(wParam) == CBN_SELCHANGE)
            {
                HWND hCombo = (HWND)lParam;

                int index = (int)SendMessageW(
                    hCombo, CB_GETCURSEL, 0, 0);

                wchar_t fontName[LF_FACESIZE] = L"";

                SendMessageW(
                    hCombo,
                    CB_GETLBTEXT,
                    index,
                    (LPARAM)fontName
                );

                SetSelectedFont(hEdit, fontName);

                g_isModified = true;
            }

            return 0;


            // ====================================================
            // 字号
            // ====================================================
        case ID_COMBO_SIZE:

            if (HIWORD(wParam) == CBN_SELCHANGE)
            {
                HWND hCombo = (HWND)lParam;

                wchar_t sizeText[20] = L"";

                int index = (int)SendMessageW(
                    hCombo, CB_GETCURSEL, 0, 0);

                SendMessageW(
                    hCombo,
                    CB_GETLBTEXT,
                    index,
                    (LPARAM)sizeText
                );

                int pointSize = _wtoi(sizeText);

                if (pointSize > 0)
                {
                    SetSelectedFontSize(hEdit, pointSize);
                    g_isModified = true;
                }
            }

            return 0;


            // ====================================================
            // Ctrl + S
            // ====================================================
        case ID_ACCEL_SAVE:

            SaveNote(hwnd);

            return 0;


            // ====================================================
            // Ctrl + F
            // ====================================================
        case ID_ACCEL_FIND:

            ShowFindWindow(hwnd);

            return 0;
        }

        break;
    }


    // ========================================================
    // 关闭窗口
    // ========================================================
    case WM_CLOSE:
    {
        if (g_isModified)
        {
            int result = MessageBoxW(
                hwnd,
                L"文件内容已经修改，是否保存？",
                L"LightNote",
                MB_YESNOCANCEL | MB_ICONQUESTION
            );

            if (result == IDYES)
            {
                SaveNote(hwnd);
                DestroyWindow(hwnd);
            }
            else if (result == IDNO)
            {
                DestroyWindow(hwnd);
            }
            else if (result == IDCANCEL)
            {
                return 0;
            }
        }
        else
        {
            DestroyWindow(hwnd);
        }

        return 0;
    }


    // ========================================================
    // 窗口销毁
    // ========================================================
    case WM_DESTROY:
    {
        PostQuitMessage(0);
        return 0;
    }
    }


    return DefWindowProcW(
        hwnd,
        message,
        wParam,
        lParam
    );
}


// ============================================================
// 程序入口
// ============================================================
int WINAPI wWinMain(
    HINSTANCE hInstance,
    HINSTANCE hPrevInstance,
    PWSTR pCmdLine,
    int nCmdShow)
{
    g_hInstance = hInstance;

    // ========================================================
    // 初始化通用控件（状态栏需要）
    // ========================================================
    INITCOMMONCONTROLSEX icc = {};
    icc.dwSize = sizeof(icc);
    icc.dwICC = ICC_BAR_CLASSES;
    InitCommonControlsEx(&icc);


    // ========================================================
    // 加载 Rich Edit 动态库
    // ========================================================
    LoadLibraryW(L"Riched20.dll");


    // ========================================================
    // 注册窗口类
    // ========================================================
    WNDCLASSW wc = {};

    wc.lpfnWndProc = WndProc;
    wc.hInstance = hInstance;
    wc.lpszClassName = L"LightNoteWindow";
    wc.hCursor = LoadCursor(NULL, IDC_ARROW);
    wc.hbrBackground = (HBRUSH)(COLOR_WINDOW + 1);

    RegisterClassW(&wc);


    // ========================================================
    // 创建主窗口
    // ========================================================
    HWND hwnd = CreateWindowW(
        L"LightNoteWindow",
        L"LightNote - 学习笔记",
        WS_OVERLAPPEDWINDOW,
        CW_USEDEFAULT,
        CW_USEDEFAULT,
        900,
        600,
        NULL,
        NULL,
        hInstance,
        NULL
    );


    // ========================================================
    // 创建 Rich Edit 编辑框
    // ========================================================
    hEdit = CreateWindowExW(
        WS_EX_CLIENTEDGE,
        L"RichEdit20W",
        L"",
        WS_CHILD | WS_VISIBLE |
        ES_MULTILINE |
        ES_AUTOVSCROLL | ES_AUTOHSCROLL |
        WS_VSCROLL | WS_HSCROLL |
        ES_NOHIDESEL,
        0, 55, 900, 545,
        hwnd,
        NULL,
        hInstance,
        NULL
    );

    // 让编辑框把“选择变化”通知发给主窗口
    {
        LRESULT eventMask = SendMessageW(hEdit, EM_GETEVENTMASK, 0, 0);
        SendMessageW(hEdit, EM_SETEVENTMASK, 0,
            (LPARAM)(eventMask | ENM_SELCHANGE));
    }


    // ========================================================
    // 设置编辑框默认字体
    // ========================================================
    CHARFORMATW cf = {};

    cf.cbSize = sizeof(CHARFORMATW);
    cf.dwMask = CFM_FACE | CFM_SIZE;

    wcscpy_s(
        cf.szFaceName,
        LF_FACESIZE,
        L"微软雅黑"
    );

    cf.yHeight = 12 * 20;

    SendMessageW(
        hEdit,
        EM_SETCHARFORMAT,
        SCF_ALL,
        (LPARAM)&cf
    );


    // ========================================================
    // 显示窗口
    // ========================================================
    ShowWindow(hwnd, nCmdShow);
    UpdateWindow(hwnd);

    // 首次刷新状态栏
    UpdateStatusBar();


    // ========================================================
    // 创建快捷键
    //
    // Ctrl + S = 保存
    // Ctrl + F = 查找
    // ========================================================
    ACCEL accels[2] = {};

    accels[0].fVirt = FCONTROL | FVIRTKEY;
    accels[0].key = 'S';
    accels[0].cmd = ID_ACCEL_SAVE;

    accels[1].fVirt = FCONTROL | FVIRTKEY;
    accels[1].key = 'F';
    accels[1].cmd = ID_ACCEL_FIND;

    HACCEL hAccel = CreateAcceleratorTableW(accels, 2);


    // ========================================================
    // 消息循环
    // ========================================================
    MSG msg = {};

    while (GetMessageW(&msg, NULL, 0, 0))
    {
        if (!TranslateAcceleratorW(hwnd, hAccel, &msg))
        {
            TranslateMessage(&msg);
            DispatchMessageW(&msg);
        }
    }

    DestroyAcceleratorTable(hAccel);

    return (int)msg.wParam;
}
