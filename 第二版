// ============================================================
// RTF 保存回调：把编辑框内容写入文件
// ============================================================
static DWORD CALLBACK SaveRtfCallback(
    DWORD_PTR dwCookie,
    LPBYTE pbBuff,
    LONG cb,
    LONG* pcb)
{
    HANDLE hFile = (HANDLE)dwCookie;
    DWORD written = 0;

    if (!WriteFile(hFile, pbBuff, (DWORD)cb, &written, NULL))
    {
        *pcb = 0;
        return 1;
    }

    *pcb = (LONG)written;
    return 0;
}


// ============================================================
// RTF 加载回调：从文件读入编辑框
// ============================================================
static DWORD CALLBACK LoadRtfCallback(
    DWORD_PTR dwCookie,
    LPBYTE pbBuff,
    LONG cb,
    LONG* pcb)
{
    HANDLE hFile = (HANDLE)dwCookie;
    DWORD read = 0;

    if (!ReadFile(hFile, pbBuff, (DWORD)cb, &read, NULL))
    {
        *pcb = 0;
        return 1;
    }

    *pcb = (LONG)read;
    return 0;
}


// ============================================================
// 设置选中文字的字体
// ============================================================
void SetSelectedFont(HWND hwndEdit, const wchar_t* fontName)
{
    CHARFORMATW cf = {};

    cf.cbSize = sizeof(CHARFORMATW);
    cf.dwMask = CFM_FACE;

    wcscpy_s(
        cf.szFaceName,
        LF_FACESIZE,
        fontName
    );

    SendMessageW(
        hwndEdit,
        EM_SETCHARFORMAT,
        SCF_SELECTION,
        (LPARAM)&cf
    );
}


// ============================================================
// 设置选中文字的字号
//
// Rich Edit 中字号使用 twips
// 1 磅 = 20 twips
// ============================================================
void SetSelectedFontSize(HWND hwndEdit, int pointSize)
{
    CHARFORMATW cf = {};

    cf.cbSize = sizeof(CHARFORMATW);
    cf.dwMask = CFM_SIZE;

    cf.yHeight = pointSize * 20;

    SendMessageW(
        hwndEdit,
        EM_SETCHARFORMAT,
        SCF_SELECTION,
        (LPARAM)&cf
    );
}


// ============================================================
// 执行查找
// ============================================================
void FindTextInEdit(HWND hwndEdit, const std::wstring& searchText)
{
    if (searchText.empty())
    {
        MessageBoxW(
            g_hFindWindow,
            L"请输入要查找的文字。",
            L"查找",
            MB_OK | MB_ICONINFORMATION
        );

        return;
    }

    CHARRANGE range = {};

    SendMessageW(
        hwndEdit,
        EM_EXGETSEL,
        0,
        (LPARAM)&range
    );

    FINDTEXTW ft = {};

    ft.chrg.cpMin = range.cpMax;
    ft.chrg.cpMax = -1;
    ft.lpstrText = searchText.c_str();

    LONG result = (LONG)SendMessageW(
        hwndEdit,
        EM_FINDTEXTW,
        FR_DOWN,
        (LPARAM)&ft
    );

    if (result == -1)
    {
        ft.chrg.cpMin = 0;
        ft.chrg.cpMax = -1;

        result = (LONG)SendMessageW(
            hwndEdit,
            EM_FINDTEXTW,
            FR_DOWN,
            (LPARAM)&ft
        );
    }

    if (result != -1)
    {
        CHARRANGE foundRange = {};

        foundRange.cpMin = result;
        foundRange.cpMax =
            result + (LONG)searchText.length();

        SendMessageW(
            hwndEdit,
            EM_EXSETSEL,
            0,
            (LPARAM)&foundRange
        );

        SendMessageW(
            hwndEdit,
            EM_SCROLLCARET,
            0,
            0
        );
    }
    else
    {
        MessageBoxW(
            g_hFindWindow,
            L"没有找到指定文字。",
            L"查找",
            MB_OK | MB_ICONINFORMATION
        );
    }
}


// ============================================================
// 更新状态栏（行、列、字符数、修改状态）
// ============================================================
void UpdateStatusBar()
{
    if (hEdit == NULL || hStatus == NULL)
        return;

    CHARRANGE range = {};
    SendMessageW(hEdit, EM_EXGETSEL, 0, (LPARAM)&range);

    LONG line = (LONG)SendMessageW(
        hEdit,
        EM_LINEFROMCHAR,
        (WPARAM)range.cpMin,
        0
    );

    LONG lineStart = (LONG)SendMessageW(
        hEdit,
        EM_LINEINDEX,
        (WPARAM)line,
        0
    );

    int column = 1;
    if (lineStart >= 0 && range.cpMin >= lineStart)
        column = (int)(range.cpMin - lineStart) + 1;

    int charCount = GetWindowTextLengthW(hEdit);

    wchar_t part1[64] = {};
    swprintf_s(part1, L"行：%ld  列：%d",
        line + 1, column);

    wchar_t part2[64] = {};
    swprintf_s(part2, L"字符数：%d", charCount);

    const wchar_t* part3 = g_isModified ? L"已修改" : L"就绪";

    SendMessageW(hStatus, SB_SETTEXTW, 0, (LPARAM)part1);
    SendMessageW(hStatus, SB_SETTEXTW, 1, (LPARAM)part2);
    SendMessageW(hStatus, SB_SETTEXTW, 2, (LPARAM)part3);
}


// ============================================================
// 查找窗口过程函数
// ============================================================
LRESULT CALLBACK FindWndProc(
    HWND hwnd,
    UINT message,
    WPARAM wParam,
    LPARAM lParam)
{
    switch (message)
    {
    case WM_CREATE:
    {
        CreateWindowW(
            L"STATIC",
            L"查找内容：",
            WS_CHILD | WS_VISIBLE,
            15, 18, 80, 25,
            hwnd,
            NULL,
            g_hInstance,
            NULL
        );

        g_hFindEdit = CreateWindowW(
            L"EDIT",
            L"",
            WS_CHILD | WS_VISIBLE | WS_BORDER | ES_AUTOHSCROLL,
            95, 15, 210, 28,
            hwnd,
            (HMENU)ID_FIND_EDIT,
            g_hInstance,
            NULL
        );

        CreateWindowW(
            L"BUTTON",
            L"查找",
            WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON,
            315, 15, 70, 28,
            hwnd,
            (HMENU)ID_FIND_BUTTON,
            g_hInstance,
            NULL
        );

        SetFocus(g_hFindEdit);

        return 0;
    }


    case WM_COMMAND:
    {
        if (LOWORD(wParam) == ID_FIND_BUTTON)
        {
            wchar_t buffer[256] = L"";

            GetWindowTextW(
                g_hFindEdit,
                buffer,
                256
            );

            FindTextInEdit(
                hEdit,
                buffer
            );

            return 0;
        }

        return 0;
    }


    case WM_KEYDOWN:
    {
        if (wParam == VK_RETURN)
        {
            wchar_t buffer[256] = L"";

            GetWindowTextW(
                g_hFindEdit,
                buffer,
                256
            );

            FindTextInEdit(
                hEdit,
                buffer
            );

            return 0;
        }

        break;
    }


    case WM_CLOSE:
    {
        g_hFindWindow = NULL;
        g_hFindEdit = NULL;

        EnableWindow(
            GetParent(hwnd),
            TRUE
        );

        DestroyWindow(hwnd);

        return 0;
    }
    }

    return DefWindowProcW(
        hwnd,
        message,
        wParam,
        lParam
    );
}


// ============================================================
// 创建查找窗口
// ============================================================
void ShowFindWindow(HWND hwndParent)
{
    if (g_hFindWindow != NULL)
    {
        SetForegroundWindow(g_hFindWindow);
        return;
    }

    WNDCLASSW wc = {};

    wc.lpfnWndProc = FindWndProc;
    wc.hInstance = g_hInstance;
    wc.lpszClassName = L"LightNoteFindWindow";
    wc.hCursor = LoadCursor(NULL, IDC_ARROW);
    wc.hbrBackground =
        (HBRUSH)(COLOR_WINDOW + 1);

    RegisterClassW(&wc);

    g_hFindWindow = CreateWindowW(
        L"LightNoteFindWindow",
        L"查找",
        WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU,
        CW_USEDEFAULT,
        CW_USEDEFAULT,
        420,
        95,
        hwndParent,
        NULL,
        g_hInstance,
        NULL
    );

    if (g_hFindWindow != NULL)
    {
        EnableWindow(
            hwndParent,
            FALSE
        );

        ShowWindow(
            g_hFindWindow,
            SW_SHOW
        );

        UpdateWindow(
            g_hFindWindow
        );
    }
}


// ============================================================
// 打开笔记（RTF 或 纯文本 都能读）
// ============================================================
void OpenNote(HWND hwnd)
{
    OPENFILENAMEW ofn = {};

    wchar_t fileName[MAX_PATH] = L"";

    ofn.lStructSize =
        sizeof(OPENFILENAMEW);

    ofn.hwndOwner = hwnd;

    ofn.lpstrFilter =
        L"富文本文件 (*.rtf)\0*.rtf\0"
        L"文本文件 (*.txt)\0*.txt\0"
        L"所有文件 (*.*)\0*.*\0";

    ofn.lpstrFile = fileName;

    ofn.nMaxFile = MAX_PATH;

    ofn.Flags =
        OFN_FILEMUSTEXIST |
        OFN_PATHMUSTEXIST;

    ofn.lpstrDefExt = L"rtf";


    if (GetOpenFileNameW(&ofn))
    {
        HANDLE hFile = CreateFileW(
            fileName,
            GENERIC_READ,
            FILE_SHARE_READ,
            NULL,
            OPEN_EXISTING,
            FILE_ATTRIBUTE_NORMAL,
            NULL
        );

        if (hFile != INVALID_HANDLE_VALUE)
        {
            // 用 EM_STREAMIN 让 Rich Edit 自己解析
            // SF_RTF 会先按 RTF 解析；如果不是 RTF，会自动退回纯文本
            EDITSTREAM es = {};
            es.dwCookie = (DWORD_PTR)hFile;
            es.pfnCallback = LoadRtfCallback;

            SendMessageW(hEdit, EM_STREAMIN, SF_RTF, (LPARAM)&es);

            // 如果按 RTF 读失败（例如是纯 txt），再按纯文本读一次
            if (es.dwError != 0)
            {
                SetFilePointer(hFile, 0, NULL, FILE_BEGIN);

                es.dwCookie = (DWORD_PTR)hFile;
                es.pfnCallback = LoadRtfCallback;
                es.dwError = 0;

                SendMessageW(hEdit, EM_STREAMIN, SF_TEXT, (LPARAM)&es);
            }

            CloseHandle(hFile);

            // 记录路径
            g_currentFilePath = fileName;

            // 打开不算修改
            g_isModified = false;

            // 光标回到开头
            CHARRANGE cr = { 0, 0 };
            SendMessageW(hEdit, EM_EXSETSEL, 0, (LPARAM)&cr);

            UpdateStatusBar();
        }
        else
        {
            MessageBoxW(
                hwnd,
                L"文件打开失败！",
                L"LightNote",
                MB_OK | MB_ICONERROR
            );
        }
    }
}


// ============================================================
// 保存笔记（以 RTF 格式保存，保留格式）
//
// 第一次保存：弹出另存为
// 第二次以后：直接覆盖原文件
// ============================================================
void SaveNote(HWND hwnd)
{
    // ==============================
    // 第一次保存
    // ==============================
    if (g_currentFilePath.empty())
    {
        OPENFILENAMEW ofn = {};

        wchar_t fileName[MAX_PATH] =
            L"我的笔记.rtf";

        ofn.lStructSize =
            sizeof(OPENFILENAMEW);

        ofn.hwndOwner = hwnd;

        ofn.lpstrFilter =
            L"富文本文件 (*.rtf)\0*.rtf\0"
            L"文本文件 (*.txt)\0*.txt\0"
            L"所有文件 (*.*)\0*.*\0";

        ofn.lpstrFile = fileName;

        ofn.nMaxFile = MAX_PATH;

        ofn.Flags =
            OFN_OVERWRITEPROMPT |
            OFN_PATHMUSTEXIST;

        ofn.lpstrDefExt = L"rtf";


        // 用户取消保存
        if (!GetSaveFileNameW(&ofn))
        {
            return;
        }

        // 记住第一次保存的路径
        g_currentFilePath = fileName;
    }


    // ==============================
    // 创建 / 覆盖文件
    // ==============================
    HANDLE hFile = CreateFileW(
        g_currentFilePath.c_str(),
        GENERIC_WRITE,
        0,
        NULL,
        CREATE_ALWAYS,
        FILE_ATTRIBUTE_NORMAL,
        NULL
    );


    if (hFile != INVALID_HANDLE_VALUE)
    {
        // 让 Rich Edit 把带格式的内容以 RTF 输出
        EDITSTREAM es = {};
        es.dwCookie = (DWORD_PTR)hFile;
        es.pfnCallback = SaveRtfCallback;

        SendMessageW(hEdit, EM_STREAMOUT, SF_RTF, (LPARAM)&es);

        CloseHandle(hFile);

        if (es.dwError == 0)
        {
            g_isModified = false;
            UpdateStatusBar();
        }
        else
        {
            MessageBoxW(
                hwnd,
                L"文件保存失败！",
                L"LightNote",
                MB_OK | MB_ICONERROR
            );
        }
    }
    else
    {
        MessageBoxW(
            hwnd,
            L"文件保存失败！",
            L"LightNote",
            MB_OK | MB_ICONERROR
        );
    }
}


